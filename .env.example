# Calcora AI environment configuration (template).
# Copy to .env and fill in values. Never commit the real .env, and never move the
# server-only secrets below into a VITE_-prefixed variable: those are bundled into
# the browser client instead of staying server-side.

# --- Web server --------------------------------------------------------------
# Comma-separated allowlist of origins the API accepts. Loopback origins used by
# the desktop app are always allowed.
CALCORA_ALLOWED_ORIGINS=
# Server bind address and port. Desktop builds force host 127.0.0.1 and port 0
# (ephemeral); hosted/shared deployments bind 0.0.0.0:3000 by default.
CALCORA_HOST=
CALCORA_PORT=
# Admin API bearer token; leave empty to disable admin endpoints.
CALCORA_ADMIN_TOKEN=
# Set to 1 when the desktop shell serves the app so cloud AI access can be tuned.
CALCORA_DESKTOP=
# Set to 1 to run the server directly (npm run start) without the desktop shell
# auto-starting it; otherwise the shell owns the server lifecycle.
CALCORA_MANUAL_START=
# Port chosen for the embedded API server; usually set by the desktop shell.
CALCORA_RUNTIME_PORT=
# Root of the installed app; resolved from the working directory by default. Set
# by the desktop shell; rarely needed for development.
CALCORA_APP_ROOT=

# --- Intelligence sync / privileged endpoints ---------------------------------
CALCORA_ENABLE_INTELLIGENCE_SYNC=
CALCORA_INTELLIGENCE_SCAN_TOKEN=
CALCORA_LEARNING_EVALUATION_TOKEN=

# --- Local model inference ----------------------------------------------------
# Path to the llama.cpp CLI binary used for on-device GGUF inference.
CALCORA_LLAMA_CLI_PATH=
# Directory containing local GGUF model files.
CALCORA_MODELS_DIR=
CALCORA_LLAMA_CONTEXT_SIZE=
CALCORA_LLAMA_THREADS=
# Ceiling in ms for a local model completion; the client timeout (200s default)
# sits above this so a slow on-device answer is not cut off early.
CALCORA_LOCAL_MODEL_TIMEOUT_MS=
# Ollama server base URL for local model discovery; defaults to 127.0.0.1:11434.
CALCORA_OLLAMA_URL=

# --- Server-only secrets: never add a VITE_ prefix ----------------------------
GEMINI_API_KEY=
# Optional OpenAI-compatible endpoint override for research features.
OPENAI_API_BASE=
OPENAI_API_KEY=
# Supabase service-role key (bypasses row level security): server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public (browser bundle) values -------------------------------------------
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
