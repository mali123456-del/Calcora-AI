# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase browser client (publishable key only; never put a secret key here)
VITE_SUPABASE_URL=https://igjqepnucigbuxrsvwup.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: enable automatic daily public-metadata sync. Default is off to keep
# local/offline runs free of background network requests.
CALCORA_ENABLE_INTELLIGENCE_SYNC=false

# Server-side controls. Never expose these values with the VITE_ prefix.
# Public Gemini requests are disabled by default; desktop/local requests can use
# the OS-encrypted desktop key after explicit user consent.
CALCORA_ALLOW_PUBLIC_GEMINI=false
CALCORA_INTELLIGENCE_SCAN_TOKEN=
CALCORA_LEARNING_EVALUATION_TOKEN=

# Comma-separated list of origins allowed to call the API, e.g.
# "https://calcora.app,https://app.calcora.app". A wildcard is rejected on purpose:
# it would re-open the cross-origin quota-abuse vector this setting exists to close.
# Loopback origins (localhost / 127.0.0.1) are always allowed, and the desktop app
# ignores this list entirely because it only ever serves its own local renderer.
CALCORA_ALLOWED_ORIGINS=

# Optional local GGUF inference. Calcora never downloads or installs this runtime.
# Set an absolute path to a separately installed llama.cpp llama-cli executable.
CALCORA_LLAMA_CLI_PATH=
# Defaults: ./models, context 2048, CPU threads = min(4, logical cores - 1), timeout 120000 ms.
# Override the GGUF folder when desktop models are kept outside the installed app.
CALCORA_MODELS_DIR=
CALCORA_LLAMA_CONTEXT_SIZE=2048
CALCORA_LLAMA_THREADS=
CALCORA_LOCAL_MODEL_TIMEOUT_MS=120000
